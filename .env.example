# launchfilm keys. Copy to .env (chmod 600) and fill only what you use. The free defaults need none.
# Never paste keys into chat; doctor reports set/unset only. Model ids live in harness.config.json → providers.

# tts:elevenlabs, words:elevenlabs, music:elevenlabs, sfx:elevenlabs  https://elevenlabs.io/docs/api-reference/text-to-speech/convert-with-timestamps
ELEVENLABS_API_KEY=

# tts:cartesia  https://docs.cartesia.ai/api-reference/tts/sse
CARTESIA_API_KEY=

# tts:azure  https://learn.microsoft.com/azure/ai-services/speech-service/rest-text-to-speech
AZURE_SPEECH_KEY=

# tts:azure  https://learn.microsoft.com/azure/ai-services/speech-service/rest-text-to-speech
AZURE_SPEECH_REGION=

# tts:gemini, music:lyria, image:gemini, video:gemini, vision:gemini  https://ai.google.dev/gemini-api/docs/speech-generation
GEMINI_API_KEY=

# tts:openai, image:openai  https://developers.openai.com/api/docs/guides/text-to-speech
OPENAI_API_KEY=

# words:deepgram  https://developers.deepgram.com/docs/pre-recorded-audio
DEEPGRAM_API_KEY=

# music:stable-audio, sfx:stable-audio  https://platform.stability.ai/docs/api-reference
STABILITY_API_KEY=

# sfx:freesound  https://freesound.org/docs/api/
FREESOUND_API_KEY=

# image:fal, video:fal
FAL_KEY=

# image:runway, video:runway
RUNWAYML_API_SECRET=

# Opt-outs (no telemetry exists; these only silence the one-time credit note)
# LAUNCHFILM_NO_CREDIT=1
# Unattended pipelines: no prompts, no credit, BLOCKED.md on failure
# LAUNCHFILM_BATCH=1
