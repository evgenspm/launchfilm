{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/evgenspm/launchfilm/schemas/recipe.schema.json",
  "title": "launchfilm recipe",
  "description": "One studied reference turned into a reusable recipe. Lives at studio/src/recipes/<id>/recipe.json next to recipe.md, Recipe.tsx and index.tsx.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "summary", "source", "family", "tags", "techniques", "format", "look", "audio", "structure", "inputs", "components", "difficulty"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "kebab-case, unique, e.g. 'statement-blur-launch'. Never include the source brand name."
    },
    "title": { "type": "string", "maxLength": 60, "description": "Our own descriptive title, not the source's title." },
    "summary": { "type": "string", "maxLength": 240, "description": "One or two sentences: what the viewer sees and why it works." },
    "use_when": { "type": "array", "items": { "type": "string" }, "maxItems": 5, "description": "Situations where this recipe is the right pick." },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "enum": ["raylight", "jitter", "launchvideo", "own", "other"] },
        "url": { "type": "string", "format": "uri", "description": "Link to the original. We never redistribute the original file." },
        "author": { "type": "string" },
        "author_url": { "type": "string", "format": "uri" },
        "ref_id": { "type": "string", "description": "Internal reference id, e.g. 'rl-007' or 'jt-031'." }
      }
    },
    "family": {
      "enum": ["launch-film", "product-ui", "ai-chat", "mobile-app", "kinetic-type", "logo-brand", "transitions", "social-promo", "3d-device", "data-stats"]
    },
    "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "maxItems": 12, "uniqueItems": true },
    "techniques": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Only ids from craft/vocabulary.md. Validated by scripts/validate-recipes."
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect", "duration_s", "fps"],
      "properties": {
        "aspect": { "enum": ["16:9", "9:16", "1:1", "4:5", "other"] },
        "duration_s": { "type": "number", "minimum": 1, "maximum": 180 },
        "fps": { "enum": [24, 25, 30, 50, 60] },
        "loopable": { "type": "boolean" }
      }
    },
    "look": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme"],
      "properties": {
        "theme": { "enum": ["dark", "light", "mixed"] },
        "palette": { "type": "array", "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "maxItems": 6 },
        "type_style": { "type": "string", "description": "e.g. 'large grotesk, tight tracking, blur-in'" },
        "treatment": { "type": "array", "items": { "type": "string" }, "description": "look-* techniques: grain, glow, liquid-glass…" }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vo", "music"],
      "properties": {
        "vo": { "type": "boolean" },
        "music": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "present": { "type": "boolean" },
            "bpm": { "type": ["number", "null"] },
            "energy": { "enum": ["calm", "medium", "high", "build", null] },
            "genre": { "type": ["string", "null"] },
            "cut_on_beat": { "type": "boolean" }
          }
        },
        "sfx": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event", "sound"],
            "properties": {
              "event": { "type": "string", "description": "what happens on screen" },
              "sound": { "type": "string", "description": "audio id from craft/vocabulary.md#audio" }
            }
          }
        }
      }
    },
    "structure": {
      "type": "array",
      "minItems": 1,
      "description": "Beat sheet. Times in seconds of the reference (or of our version when source=own).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t0", "t1", "beat", "shot"],
        "properties": {
          "t0": { "type": "number", "minimum": 0 },
          "t1": { "type": "number", "minimum": 0 },
          "beat": { "enum": ["hook", "problem", "tension", "reveal", "feature", "proof", "social-proof", "cta", "logo", "outro"] },
          "shot": { "type": "string", "description": "what is on screen" },
          "camera": { "type": "string" },
          "motion": { "type": "string", "description": "how elements move: springs, staggers, durations in frames" },
          "transition_out": { "type": "string", "description": "transition technique id or 'hard-cut'" },
          "sfx": { "type": "string" }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "description": "What the user must provide to make their own version.",
      "properties": {
        "product_name": { "type": "boolean" },
        "logo": { "type": "boolean" },
        "tagline": { "type": "boolean" },
        "lines": { "type": "integer", "minimum": 0, "description": "number of short copy lines" },
        "screenshots": { "type": "integer", "minimum": 0 },
        "screen_recording": { "type": "boolean" },
        "ui_rebuild": { "type": "boolean", "description": "needs the product UI rebuilt in React" },
        "stats": { "type": "integer", "minimum": 0 },
        "url": { "type": "boolean" }
      }
    },
    "components": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Studio components/presets used by Recipe.tsx (exported names)."
    },
    "params": {
      "type": "object",
      "description": "Props of Recipe.tsx beyond brand: name → short description. Lets an agent remix without reading the code."
    },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "render_cost": { "enum": ["light", "medium", "heavy"], "description": "heavy = WebGL/3D/motion-blur" },
    "notes": { "type": "string", "description": "pitfalls, measured numbers worth keeping" },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "video": { "type": "string", "description": "our render, URL on media.eugenefounder.lol" },
        "poster": { "type": "string" },
        "demo_brand": { "type": "string", "description": "which demo brand the preview uses" }
      }
    },
    "status": { "enum": ["studied", "built", "reviewed"], "description": "studied = recipe.md/json only; built = Recipe.tsx renders; reviewed = passed human/agent QA" }
  }
}
