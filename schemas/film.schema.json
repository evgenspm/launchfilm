{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/evgenspm/launchfilm/schemas/film.schema.json",
  "title": "launchfilm film",
  "description": "A whole film as data: studio/films/<slug>/film.json. Times are seconds (or beats); paths are relative to studio/public/ (per-film media in public/films/<slug>/). Read by the film engine (studio/src/film/Film.tsx): one composition per aspect, id '<id>-16x9'. Shape = studio/src/film/types.ts (FilmSpec).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "fps",
    "aspects",
    "shots"
  ],
  "$defs": {
    "aspect": {
      "enum": [
        "16:9",
        "1:1",
        "4:5",
        "9:16"
      ]
    },
    "transition": {
      "description": "transition id from craft/vocabulary.md#transitions",
      "enum": [
        "hard-cut",
        "match-cut",
        "mask-wipe",
        "blur-dissolve",
        "slide-push",
        "flash",
        "glitch-cut",
        "zoom-through",
        "portal",
        "smash-cut-black"
      ]
    },
    "transitionOpts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "left",
            "right",
            "up",
            "down"
          ]
        },
        "shape": {
          "enum": [
            "circle",
            "linear",
            "diagonal"
          ]
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "color": {
          "type": "string"
        }
      }
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "description": "normalised source rect (0..1)",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "punch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "scale",
        "focus"
      ],
      "properties": {
        "at": {
          "type": "number",
          "minimum": 0,
          "description": "seconds from the shot start"
        },
        "scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 6
        },
        "focus": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "source-normalised point"
        },
        "out": {
          "type": "number",
          "minimum": 0,
          "description": "seconds after `at` to zoom back; omit to stay"
        }
      }
    },
    "sfx": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "number",
          "minimum": 0
        },
        "sound": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "audio id from craft/vocabulary.md#audio, resolved to public/sfx/<sound>.wav"
        },
        "src": {
          "type": "string",
          "description": "explicit file under public/ (wins over sound)"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      },
      "anyOf": [
        {
          "required": [
            "sound"
          ]
        },
        {
          "required": [
            "src"
          ]
        }
      ]
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "composition id prefix (a-z, 0-9, -); not necessarily the folder name"
    },
    "title": {
      "type": "string"
    },
    "fps": {
      "enum": [
        24,
        25,
        30,
        50,
        60
      ]
    },
    "aspects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/aspect"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 600,
      "description": "seconds; omitted = last shot / VO line / end card"
    },
    "beats": {
      "type": "object",
      "additionalProperties": false,
      "description": "beat grid for shots placed with `beat`/`beats`: a tempo, or a beats.json from `launchfilm beats` (wins)",
      "properties": {
        "bpm": {
          "type": "number",
          "minimum": 40,
          "maximum": 220
        },
        "offset": {
          "type": "number",
          "minimum": 0,
          "description": "seconds to the first beat"
        },
        "src": {
          "type": "string",
          "description": "beats.json under public/: {bpm, beats[], downbeats?, duration}"
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "at": {
            "type": "number",
            "minimum": 0,
            "description": "start, film seconds; omitted = right after the previous shot"
          },
          "beat": {
            "type": "integer",
            "minimum": 0,
            "description": "start on beat n of the grid (wins over at)"
          },
          "dur": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "length in seconds"
          },
          "beats": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "length in beats (wins over dur)"
          },
          "scene": {
            "type": "string",
            "description": "built-in: title | statement | caption | logo | blank, or a key of the film's own scenes (scenes.tsx)"
          },
          "src": {
            "type": "string",
            "description": "footage under public/ (used when there is no scene)"
          },
          "trim": {
            "type": "number",
            "minimum": 0,
            "description": "seconds into the footage"
          },
          "crop": {
            "type": "object",
            "additionalProperties": false,
            "description": "per-aspect crop of the footage; missing aspect = centred cover",
            "properties": {
              "16:9": {
                "$ref": "#/$defs/crop"
              },
              "1:1": {
                "$ref": "#/$defs/crop"
              },
              "4:5": {
                "$ref": "#/$defs/crop"
              },
              "9:16": {
                "$ref": "#/$defs/crop"
              }
            }
          },
          "punch": {
            "oneOf": [
              {
                "$ref": "#/$defs/punch"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/punch"
                }
              }
            ]
          },
          "drift": {
            "type": "number",
            "minimum": 1,
            "maximum": 1.3,
            "description": "slow push across the shot, default 1.03"
          },
          "size": {
            "type": "array",
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "source pixel size of the footage"
          },
          "playbackRate": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "transition": {
            "$ref": "#/$defs/transition",
            "description": "transition INTO this shot (default hard-cut)"
          },
          "transitionOpts": {
            "$ref": "#/$defs/transitionOpts"
          },
          "sfx": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/sfx"
            },
            "description": "`at` = seconds into the shot"
          },
          "props": {
            "type": "object",
            "description": "anything the scene reads (texts, variants)"
          }
        },
        "anyOf": [
          {
            "required": [
              "scene"
            ]
          },
          {
            "required": [
              "src"
            ]
          }
        ]
      }
    },
    "vo": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "text": {
            "type": "string",
            "description": "script line; *word* = emphasis (accent in subtitles), | = subtitle break"
          },
          "at": {
            "type": "number",
            "minimum": 0,
            "description": "film seconds where the line starts"
          },
          "src": {
            "type": "string",
            "description": "wav/mp3 under public/; omitted = silent, subtitles on estimated timing"
          },
          "words": {
            "type": "string",
            "description": "words.json under public/ (from `launchfilm words`)"
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          }
        }
      },
      "description": "VO lines, one per script line. Script markup in `text`: *word* = accent word in the subtitles (several allowed), | = forced subtitle phrase break. Without `src` the line is silent and subtitles run on estimated timing (2.8 words/s); `words` (words.json: {text, duration, words:[{w,s,e,emph?}], phrases?:[{text,s,e,emph?}]}) makes them exact and drives music ducking."
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src"
      ],
      "properties": {
        "src": {
          "type": "string",
          "description": "bed under public/, normalised to -14 LUFS"
        },
        "level": {
          "type": "number",
          "minimum": -40,
          "maximum": -6,
          "description": "LUFS without voice (default -20)"
        },
        "duck": {
          "type": "number",
          "minimum": 0,
          "maximum": 24,
          "description": "dB lower while the voice speaks (default 9)"
        },
        "trim": {
          "type": "number",
          "minimum": 0
        },
        "at": {
          "type": "number",
          "minimum": 0
        },
        "fadeIn": {
          "type": "number",
          "minimum": 0
        },
        "fadeOut": {
          "type": "number",
          "minimum": 0
        },
        "liftOnEndCard": {
          "type": "number",
          "minimum": 0,
          "maximum": 12,
          "description": "extra dB over the end card (default 4)"
        }
      }
    },
    "sfx": {
      "type": "array",
      "description": "Sound events at film seconds (every visual event gets a sound): {at, sound | src, volume?}. `sound` is an audio id from craft/vocabulary.md#audio resolved to public/sfx/<sound>.wav.",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/sfx"
          },
          {
            "required": [
              "at"
            ]
          }
        ]
      }
    },
    "subtitles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "default: on when the film has VO"
        },
        "emph": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "fallback emphasis words"
        },
        "maxPerLine": {
          "type": "integer",
          "minimum": 3,
          "maximum": 10
        },
        "captions": {
          "type": "string",
          "description": "captions json under public/ ({phrases:[{text,s,e,emph?}]}) for films without VO"
        }
      }
    },
    "endCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dur"
      ],
      "properties": {
        "dur": {
          "type": "number",
          "minimum": 1,
          "maximum": 8,
          "description": "seconds; 2-3 s is typical"
        },
        "line": {
          "type": [
            "string",
            "null"
          ],
          "description": "default: brand tagline; null hides it"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "description": "default: brand url; null hides it"
        },
        "cta": {
          "type": "string"
        },
        "transition": {
          "$ref": "#/$defs/transition"
        }
      }
    },
    "credit": {
      "type": "boolean",
      "default": false,
      "description": "tiny 'Made with launchfilm' chip over the end card; off by default"
    },
    "look": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grain": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3
        },
        "vignette": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.6
        }
      }
    }
  }
}
